# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# .env is gitignored. Never commit real secrets.

# Nest
NODE_ENV=development
PORT=3001
SWAGGER_PATH=docs
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# NestLens (Telescope-like dashboard - http://localhost:PORT/nestlens)
NESTLENS_ENABLED=true
NESTLENS_PATH=/nestlens

# PostgreSQL + PostGIS (Docker + Nest)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=tradie
POSTGRES_PASSWORD=tradie
POSTGRES_DB=tradie
DATABASE_URL=postgresql://tradie:tradie@localhost:5433/tradie
# Keep false in normal development — use npm run migration:run
TYPEORM_SYNC=false
TYPEORM_LOGGING=false

# Redis (Docker + Nest)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
SESSION_TTL_SECONDS=3600

# Firebase Authentication
# mock  = local development without a Firebase project (default)
# firebase = use Firebase Admin + Identity Toolkit (requires credentials below)
FIREBASE_AUTH_MODE=mock
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private key with \n for newlines, or use FIREBASE_SERVICE_ACCOUNT_PATH
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_PATH=
# Web API key from Firebase console (required for email/password sign-in in firebase mode)
FIREBASE_API_KEY=
FIREBASE_AUTH_EMULATOR_HOST=

# Rate limiting (ms window / max requests)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
THROTTLE_AUTH_TTL=60000
THROTTLE_AUTH_LIMIT=10
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Email (HU03 - mock logs reset link when SMTP is empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@tradie.dev
FRONTEND_RESET_URL=http://localhost:3000/reset-password
PASSWORD_RESET_TTL=3600

# Dev seed (only when NODE_ENV=development)
SEED_ADMIN_EMAIL=admin@tradie.dev
SEED_ADMIN_PASSWORD=Admin123!
SEED_ADMIN_NAME=Tradie Admin

# pgAdmin (http://localhost:5050)
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@tradie.dev
PGADMIN_DEFAULT_PASSWORD=tradie

# Redis Insight (http://localhost:5540)
REDIS_INSIGHT_PORT=5540
